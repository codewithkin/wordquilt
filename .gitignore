# Generated from designs/*.dc.html by `pnpm designs:extract`.
# Never committed — re-run the extractor instead. The .dc.html files are the
# source of truth; these are a readable projection of them.
designs/extracted/

# Continuous native generation: ios/ and android/ are regenerated by
# `expo prebuild` from app.json and are not the source of truth.
# NOTE: prebuild re-adds an alpha channel to the dark iOS icon, so
# `pnpm check:icons` must run after every prebuild. See scripts/flatten-ios-icons.mjs.
apps/native/ios/
apps/native/android/
